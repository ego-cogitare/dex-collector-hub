# Triton (Yellowstone gRPC) и HTTP RPC (дотягивание пропусков AMM)
WS_RPC=
TRITON_ONE_TOKEN=
RPC=

# MySQL (те же таблицы, что у коллекторов copy-trade-solana)
MYSQL_HOST=
MYSQL_USERNAME=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# Источники: какие площадки слушать и что писать в MySQL
SOURCES=pump_bc,pump_amm,launchlab,meteora_dbc,blockhash,bsc,meta,funding
BLOCKHASH_MS=1000          # опрос getLatestBlockhash (confirmed)
DB_WRITE=1                 # 0 — только раздача, без записи в MySQL (проверка)

# pump.fun кривая: окна записи (как в sandbox/trader.js)
PUMP_BC_SOL_WINDOW_MS=185000
PUMP_BC_MAYHEM_WINDOW_MS=600000

# pump.fun AMM
AMM_WINDOW_MIN=60
AMM_CONFIRM_MS=3000
AMM_FALLBACK_MS=30000

# Раздача
HUB_PORT=7710
HUB_BIND=0.0.0.0
HUB_RING=20000             # записей на канал для дозапроса после переподключения клиента
HUB_MAX_CLIENT_BUF_MB=64   # клиент, отставший больше чем на столько, отключается

# BNB Chain (источник bsc): websocket для eth_subscribe logs и HTTP RPC (eth_call)
BSC_WS_URL=wss://bsc-rpc.publicnode.com
BSC_RPC_URL=https://bsc-rpc.publicnode.com

# meta: метадата монет pump.fun. META_ALL=1 — для всех созданных (по умолчанию — SOL и не mayhem, как писал трейдер).
# Шлюзы IPFS: IPFS_GATEWAYS, PINATA_GATEWAY, IPFS_TIMEOUT_MS и др. — src/ipfs-fetch.js
META_ALL=0

# funding: трассировщик фандинга (src/sources/pump-funding.js). Ключи Helius через запятую.
HELIUS_API_KEY=
FETCH_FUNDING_MIN_SWAPS=15
FETCH_FUNDING_WALLETS_N=1
FETCH_FUNDING_DEPTH=1
# FUNDING_CACHE_FILE=data/funding_cache.jsonl  FUNDING_OUT_FILE=data/funding_results.jsonl
